# Flash size must match the partition table budget in partitions.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table: dual-OTA + LittleFS config storage.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 6-channel GPIO-direct reference board (locked-in target hardware).
CONFIG_SS_CHANNEL_COUNT=6

# Enabled now that components/ota provides the confirm/rollback call
# (ota_confirm_if_healthy() in main.c) this requires. Previously left off
# deliberately since turning it on without a confirmation call would leave
# every boot stuck in PENDING_VERIFY and rollback-loop on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
