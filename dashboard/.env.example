# Smart Control dashboard — copy to `.env.production` (for `npm run build` +
# `npm run start` / pm2) or `.env.local` (for `npm run dev`).
#
# NOTE: next.config.mjs bakes the CSP (which includes PUBLIC_WS_URL's origin)
# into the build, so this file must exist BEFORE `npm run build`. Rebuild
# after changing PUBLIC_WS_URL.

# Where the dashboard's server-side BFF reaches the Express backend. Keep it
# on loopback — the browser never talks to this URL directly.
BACKEND_URL=http://127.0.0.1:3000

# The dashboard's own public origin. Mutating BFF requests must carry exactly
# this Origin header (CSRF check). Local dev: http://localhost:3001
DASHBOARD_ORIGIN=https://dashboard.smart-switch.shop

# Backend client WebSocket the BROWSER connects to for live switch state
# (it gets a short-lived token from /api/auth/ws-token). Local dev:
# ws://localhost:3000/ws
PUBLIC_WS_URL=wss://api.smart-switch.shop/ws

# Public base URL of the backend, used in the API docs / curl examples on
# the API & Integrations page. Local dev: http://localhost:3000
PUBLIC_API_URL=https://api.smart-switch.shop
