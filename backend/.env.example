# Copy to .env and fill in real values before running.

DATABASE_URL=postgres://smartswitch:smartswitch@localhost:5432/smartswitch
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Interface to bind. In production set HOST=127.0.0.1 so the API is only
# reachable through the Cloudflare tunnel / dashboard BFF on this machine
# (required for TRUST_PROXY=loopback below to be safe). Unset = all interfaces.
# HOST=127.0.0.1

# Which proxies to trust for X-Forwarded-For (per-IP rate limits). Either a
# hop count (e.g. 1 for a single nginx) or an Express trust-proxy value.
# Production: TRUST_PROXY=loopback — cloudflared and the dashboard BFF both
# connect from 127.0.0.1 and forward the real client IP. Leave unset when
# the server is reachable directly (clients could otherwise spoof their IP).
# TRUST_PROXY=loopback

# Public base URL of this API — used to build hook URLs returned by
# POST /hooks and the OpenAPI `servers` entry. No trailing slash.
PUBLIC_API_URL=https://api.smart-switch.shop
