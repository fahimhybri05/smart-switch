<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Device API calls and mDNS discovery are LAN-only, no internet needed,
         but INTERNET is still required for Android to allow any socket I/O. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lets widget taps reach the network while the app is in the background
         (see MainActivity's battery channel). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Required to receive multicast (mDNS) packets — see multicast_dns package docs. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- ConnectivityManager.requestNetwork/bindProcessToNetwork, used during
         SoftAP provisioning to force traffic over the device's no-internet
         AP instead of mobile data — see MainActivity.kt. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- Android 13+ runtime permission for the background monitor's local
         notifications (schedule/offline alerts) — see background_monitor_service.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- QR-code scanning for the Add Device wizard — see mobile_scanner. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="smart_switch"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lets the home-screen widget's "open app" tap (see
                 SmartSwitchWidgetProvider.kt) target this Activity explicitly. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH"/>
            </intent-filter>
        </activity>
        <!-- Home-screen widget (Settings > Home screen widget) — see
             SmartSwitchWidgetProvider.kt. -->
        <receiver android:name=".SmartSwitchWidgetProvider" android:exported="true"
            android:label="Smart Switch — grid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/smart_switch_widget_info"/>
        </receiver>
        <!-- Single-switch widget, one switch per instance — see
             SingleSwitchWidgetProvider.kt / SingleSwitchConfigureActivity.kt. -->
        <receiver android:name=".SingleSwitchWidgetProvider" android:exported="true"
            android:label="Smart Switch — single">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/single_switch_widget_info"/>
        </receiver>
        <activity android:name=".SingleSwitchConfigureActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>
        <!-- Routes a widget row tap to widget_service.dart's headless
             toggle callback without launching the full app. -->
        <receiver android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver" android:exported="true">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
