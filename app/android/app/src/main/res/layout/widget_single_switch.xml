<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tile_off"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/single_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_circle_off">

        <ImageView
            android:id="@+id/single_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_power"
            android:contentDescription="@null"/>
    </FrameLayout>

    <TextView
        android:id="@+id/single_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Choose a switch"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/single_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"/>
</LinearLayout>
